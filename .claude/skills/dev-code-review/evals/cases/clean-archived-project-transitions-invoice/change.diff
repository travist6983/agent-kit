diff --git a/api/src/projects/__tests__/archiveProject.test.js b/api/src/projects/__tests__/archiveProject.test.js
new file mode 100644
index 0000000..5c2629f
--- /dev/null
+++ b/api/src/projects/__tests__/archiveProject.test.js
@@ -0,0 +1,20 @@
+jest.mock("../projectStore");
+jest.mock("../../invoices/invoiceStore");
+const { findProject, saveProject } = require("../projectStore");
+const { archiveOpenInvoices } = require("../../invoices/invoiceStore");
+const { archiveProject } = require("../archiveProject");
+
+const admin = { id: 7, role: "admin", workspaceId: 3 };
+
+test("archiving a project archives its open invoices in the same workspace", async () => {
+  findProject.mockResolvedValue({ id: 11, archived: false });
+  saveProject.mockResolvedValue();
+  await archiveProject(admin, 11);
+  expect(archiveOpenInvoices).toHaveBeenCalledWith(3, 11);
+});
+
+test("a non-admin cannot archive, and no invoice changes", async () => {
+  findProject.mockResolvedValue({ id: 11, archived: false });
+  await expect(archiveProject({ ...admin, role: "member" }, 11)).rejects.toThrow("only an admin");
+  expect(archiveOpenInvoices).not.toHaveBeenCalled();
+});
